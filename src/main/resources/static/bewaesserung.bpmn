<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:process id="bewaesserung_platz" name="Bewässerung Platz" isExecutable="true" camunda:historyTimeToLive="P180D">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_To_Sensoren</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_Sensoren" name="Sensor auslesen" camunda:delegateExpression="${getSensorDataDelegate}">
      <bpmn:incoming>Flow_To_Sensoren</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Entscheidung" name="Boden zu trocken?">
      <bpmn:incoming>Flow_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Ja" name="Ja" sourceRef="Gateway_Entscheidung" targetRef="Activity_VentilOeffnen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bodenZuTrocken == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Nein" name="Nein" sourceRef="Gateway_Entscheidung" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bodenZuTrocken == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_VentilOeffnen" name="Ventil öffnen" camunda:delegateExpression="${openValve}">
      <bpmn:incoming>Flow_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_1kcum5g</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_Timer20Min" name="1 Min warten">
      <bpmn:incoming>Flow_0qv033h</bpmn:incoming>
      <bpmn:outgoing>Flow_0evwahi</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_VentilSchliessen" name="Ventil schließen" camunda:delegateExpression="${closeValve}">
      <bpmn:incoming>Flow_To_VentilSchliessen</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Ende_Ja</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Ende">
      <bpmn:incoming>Flow_To_Ende_Ja</bpmn:incoming>
      <bpmn:incoming>Flow_Nein</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_To_Sensoren" sourceRef="StartEvent_1" targetRef="Activity_Sensoren" />
    <bpmn:sequenceFlow id="Flow_To_Gateway" sourceRef="Activity_Sensoren" targetRef="Gateway_Entscheidung" />
    <bpmn:sequenceFlow id="Flow_To_Timer" sourceRef="Activity_1slrdxt" targetRef="Gateway_00iz740" />
    <bpmn:sequenceFlow id="Flow_To_VentilSchliessen" name="Feucht genug" sourceRef="Gateway_00iz740" targetRef="Activity_VentilSchliessen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bodenZuTrocken == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_To_Ende_Ja" sourceRef="Activity_VentilSchliessen" targetRef="EndEvent_1" />
    <bpmn:exclusiveGateway id="Gateway_00iz740" name="Feuchte erreicht?">
      <bpmn:incoming>Flow_To_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_To_VentilSchliessen</bpmn:outgoing>
      <bpmn:outgoing>Flow_0qv033h</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1slrdxt" name="Feuchte messen" camunda:delegateExpression="${getSensorDataDelegate}">
      <bpmn:incoming>Flow_1kcum5g</bpmn:incoming>
      <bpmn:incoming>Flow_0evwahi</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Timer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1kcum5g" sourceRef="Activity_VentilOeffnen" targetRef="Activity_1slrdxt" />
    <bpmn:sequenceFlow id="Flow_0qv033h" name="Noch trocken" sourceRef="Gateway_00iz740" targetRef="Event_Timer20Min">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bodenZuTrocken == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0evwahi" sourceRef="Event_Timer20Min" targetRef="Activity_1slrdxt" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="bewaesserung_platz">
      <bpmndi:BPMNShape id="_BPMMHape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="249" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="255" y="135" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Sensoren_di" bpmnElement="Activity_Sensoren">
        <dc:Bounds x="217" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Entscheidung_di" bpmnElement="Gateway_Entscheidung" isMarkerVisible="true">
        <dc:Bounds x="242" y="300" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="244" y="357" width="47" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_VentilOeffnen_di" bpmnElement="Activity_VentilOeffnen">
        <dc:Bounds x="360" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="232" y="782" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="237" y="818" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_VentilSchliessen_di" bpmnElement="Activity_VentilSchliessen">
        <dc:Bounds x="360" y="680" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1slrdxt_di" bpmnElement="Activity_1slrdxt">
        <dc:Bounds x="360" y="420" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_00iz740_di" bpmnElement="Gateway_00iz740" isMarkerVisible="true">
        <dc:Bounds x="385" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="303" y="580" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Timer20Min_di" bpmnElement="Event_Timer20Min">
        <dc:Bounds x="552" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="539" y="418" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Ja_di" bpmnElement="Flow_Ja">
        <di:waypoint x="292" y="325" />
        <di:waypoint x="360.00003" y="325" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="320" y="300" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Nein_di" bpmnElement="Flow_Nein">
        <di:waypoint x="242" y="325" />
        <di:waypoint x="160" y="325" />
        <di:waypoint x="160" y="800" />
        <di:waypoint x="232" y="800" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="164" y="552" width="23" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Sensoren_di" bpmnElement="Flow_To_Sensoren">
        <di:waypoint x="267" y="135" />
        <di:waypoint x="267" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Gateway_di" bpmnElement="Flow_To_Gateway">
        <di:waypoint x="267" y="260" />
        <di:waypoint x="267" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Timer_di" bpmnElement="Flow_To_Timer">
        <di:waypoint x="410" y="500" />
        <di:waypoint x="410" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_VentilSchliessen_di" bpmnElement="Flow_To_VentilSchliessen">
        <di:waypoint x="410" y="615" />
        <di:waypoint x="410" y="680" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="391" y="644.5" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Ende_Ja_di" bpmnElement="Flow_To_Ende_Ja">
        <di:waypoint x="410" y="760" />
